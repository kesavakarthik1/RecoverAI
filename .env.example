# ────────────────────────────────────────────────────────────────────────────
# RecoverAI — Environment Variable Template
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=RecoverAI
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
SECRET_KEY=change_this_to_a_secure_random_string

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (local development — no setup required)
DATABASE_URL=sqlite+aiosqlite:///./recoverai.db
SYNC_DATABASE_URL=sqlite:///./recoverai.db

# PostgreSQL (production)
# DATABASE_URL=postgresql+asyncpg://recoverai:password@localhost:5432/recoverai
# SYNC_DATABASE_URL=postgresql://recoverai:password@localhost:5432/recoverai

DATABASE_ECHO=false

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── AI Provider ───────────────────────────────────────────────────────────────
# Options: rule_based | openrouter
# If rule_based, no API key is required — everything works offline.
AI_PROVIDER=rule_based

# OpenRouter (optional LLM integration)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2

# ── Payment Provider ──────────────────────────────────────────────────────────
# Options: simulation | razorpay_test
# NEVER use live Razorpay credentials in this project.
PAYMENT_PROVIDER=simulation

# Razorpay test-mode credentials (optional)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Recovery Policy Defaults ──────────────────────────────────────────────────
MAX_RETRY_ATTEMPTS=3
MIN_RETRY_DELAY_HOURS=24
MAX_RECOVERY_ACTIONS_PER_TXN=5
MAX_REMINDERS_PER_CUSTOMER_PER_WEEK=2
APPROVAL_THRESHOLD_INR=50000
BATCH_MAX_ACTIONS=500

# ── File Upload ────────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10

# ── Synthetic Data ────────────────────────────────────────────────────────────
SYNTHETIC_SEED=42
SYNTHETIC_DEFAULT_COUNT=100

# ── Auto-seed demo data ───────────────────────────────────────────────────────
# On first startup, if the database is empty, RecoverAI will automatically:
#   1. Generate 100 synthetic transactions (seed=42)
#   2. Run the recovery agent on all eligible transactions
#   3. Run the 3-strategy evaluation
# This ensures the dashboard is populated immediately on first run.
# Set to false to start with an empty database (e.g. production with real data).
AUTO_SEED_DEMO_DATA=true

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=console
